ENVIRONMENT=development
DATABASE_URL=sqlite:///./medsync.db
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=false
ADMIN_EMAILS=
OPENAI_API_KEY=
# OPENAI_MODEL permanece como fallback legado do modelo avançado.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ROUTINE_MODEL=gpt-5.6-luna
OPENAI_ADVANCED_MODEL=gpt-5.6-terra
# Modelo opcional das explicações próprias do banco de questões.
OPENAI_QUESTION_MODEL=
# Quando vazio, perguntas pós-simulação usam roteamento automático.
OPENAI_SIMULATION_QUESTION_MODEL=
OPENAI_REASONING_EFFORT=low
OPENAI_FEEDBACK_MAX_OUTPUT_TOKENS=900
OPENAI_QUESTION_MAX_OUTPUT_TOKENS=450
# Preços atuais do modelo podem ser sobrescritos sem alteração de código.
OPENAI_INPUT_USD_PER_1M=
OPENAI_CACHED_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
OPENAI_TIMEOUT_SECONDS=40
OPENAI_MAX_RETRIES=0
WEB_CONCURRENCY=2
WORKER_TIMEOUT_SECONDS=90
RESEND_API_KEY=
EMAIL_FROM=MedSync <contato@medsync.com.br>
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
ASAAS_ENVIRONMENT=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
PAYMENTS_ENABLED=false
PAYMENTS_PILOT_EMAILS=
FRONTEND_URL=http://localhost:5173
