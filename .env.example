ENVIRONMENT=development
DATABASE_URL=sqlite:///./medsync.db
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=false
ADMIN_EMAILS=
OPENAI_API_KEY=
# OPENAI_MODEL permanece como fallback legado do modelo avançado.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ROUTINE_MODEL=gpt-5.6-luna
OPENAI_ADVANCED_MODEL=gpt-5.6-terra
# Modelo opcional das explicações próprias do banco de questões.
OPENAI_QUESTION_MODEL=
# Quando vazio, perguntas pós-simulação usam roteamento automático.
OPENAI_SIMULATION_QUESTION_MODEL=
OPENAI_REASONING_EFFORT=low
OPENAI_FEEDBACK_MAX_OUTPUT_TOKENS=1100
OPENAI_QUESTION_MAX_OUTPUT_TOKENS=450
# Preços atuais do modelo podem ser sobrescritos sem alteração de código.
OPENAI_INPUT_USD_PER_1M=
OPENAI_CACHED_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
OPENAI_TIMEOUT_SECONDS=40
OPENAI_MAX_RETRIES=0

# ==============================================================================
# SYNAPSE MULTI-LLM ENGINE (Plug & Play - Ativação sob demanda por Chave de API)
# Deixe as chaves vazias enquanto não estiver usando. Ao adicionar a chave, o
# motor Synapse passa a incluir o provedor na Junta Médica automaticamente.
# ==============================================================================
# Anthropic (Claude 3.5 Sonnet / Claude 3.5 Haiku) - https://console.anthropic.com
ANTHROPIC_API_KEY=
SYNAPSE_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
SYNAPSE_ENABLE_ANTHROPIC=true

# Google Gemini (Gemini 2.0 Flash / Pro) - https://aistudio.google.com
GEMINI_API_KEY=
SYNAPSE_GEMINI_MODEL=gemini-2.0-flash
SYNAPSE_ENABLE_GEMINI=true

# xAI Grok (Grok 2 / Grok Mini) - https://console.x.ai
XAI_API_KEY=
SYNAPSE_XAI_MODEL=grok-2-mini
SYNAPSE_ENABLE_XAI=true

# DeepSeek (DeepSeek-R1 Reasoning / V3) - https://platform.deepseek.com
DEEPSEEK_API_KEY=
SYNAPSE_DEEPSEEK_MODEL=deepseek-reasoner
SYNAPSE_ENABLE_DEEPSEEK=true
WEB_CONCURRENCY=2
WORKER_TIMEOUT_SECONDS=90
RESEND_API_KEY=
EMAIL_FROM=MedSync <contato@medsync.com.br>
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
ASAAS_ENVIRONMENT=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
PAYMENTS_ENABLED=false
PAYMENTS_PILOT_EMAILS=
FRONTEND_URL=http://localhost:5173
